      "id": "NAMASTE",
      "gloss": "NAMASTE / HELLO",
      "meaning_en": "Hello! Greetings.",
      "meaning_ml": "നമസ്കാരം (Hello)",
      "category": "greetings",
      "islrtc_ref": "#SAL-01",
      "verification_status": "Officially Sourced (ISLRTC)",
      "two_handed": true,
      "parameters": {
        "handshape": "Flat open palms (B-hand) pressed gently together or raised gracefully",
        "orientation": "Palms facing each other or outward toward partner",
        "location": "Center of chest or mid-level face",
        "movement": "Slight upward orientation with gentle forward bow of head",
        "non_manual_markers": "Warm smile, relaxed open facial expression, gentle nod"
      },
      "recognition_spec": {
        "hands_required": 1,
        "finger_states": {
          "thumb": "extended",
          "index": "extended",
          "middle": "extended",
          "ring": "extended",
          "pinky": "extended"
        },
        "relative_location": "chest_or_face",
        "palm_facing": "outward_or_partner",
        "motion_vector": "slight_up_or_steady",
        "facial_trigger": "smile_or_nod",
        "min_hold_ms": 450
      }
    },
